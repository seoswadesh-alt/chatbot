VENICE_API_KEY=your_venice_api_key_here
VENICE_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=venice-uncensored-role-play
VENICE_CLEAR_MODEL=gemma-4-uncensored
PORT=3000

# Billing (manual UPI + admin unlock)
# Main site login: enter ADMIN_ID + ADMIN_PASSWORD → opens admin panel automatically
ADMIN_ID=admin
ADMIN_PASSWORD=change_this_admin_password
UPI_ID=yourname@upi
UPI_NAME=Chat Service
UPI_QR_URL=/upi-qr.svg
RATE_INR_PER_HOUR=130

# Photo paint is GPU-only when COMFYUI_URL is set (no Venice image bill).
# IMAGE_BACKEND=comfy | auto | venice
IMAGE_GEN_ENABLED=false
IMAGE_GEN_PAID_ONLY=false
IMAGE_BACKEND=comfy
# COMFYUI_URL=https://YOUR_POD_ID-8188.proxy.runpod.net
# COMFYUI_API_TOKEN=
# Optional: after you upload the uncensored CLIP into text_encoders (FileBrowser 8080).
# App auto-picks it if the file exists; missing filename in .env will not break Photos.
# https://huggingface.co/martossien/qwen_2.5_vl_7b_uncensored_comfy_ready
# COMFY_CLIP=qwen_2.5_vl_7b_uncensored_comfy_ready_bf16.safetensors
# COMFY_UNET=qwen_image_edit_fp8_e4m3fn.safetensors
# COMFY_CLIP=qwen_2.5_vl_7b_fp8_scaled.safetensors
# COMFY_VAE=qwen_image_vae.safetensors
# COMFY_LORA=Qwen-Image-Edit-Lightning-4steps-V1.0-bf16.safetensors
# COMFY_WORKFLOW_FILE=data/comfy-qwen-edit-api.json
# VENICE_IMAGE_EDIT_MODEL=qwen-edit-uncensored
